/*
Default configuration file for the Quickshell Dock.

This file documents the built-in defaults (kept in sync with defaultSettings in
DockSettings.qml). The dock itself reads a single file:

  ~/.config/ml4w-dock/config.json

It is created empty on first start and merged over the
built-in defaults below, so it only needs to carry the values you want to
change. The dock writes enabled / autohide / the pinned app list back into it.

dock.triggerOnDock limits the autohide reveal to the dock's own position
instead of the whole bottom edge. It only has an effect while autohide is on.

dock.launcherCommand is what a left click on the launcher button runs. It is
run through bash, so a leading ~, arguments and pipes all work.

dock.editorCommand opens config.json when "Edit configuration" is chosen in
the dock menu (or `edit` is called over IPC). The file path is appended as the
last argument. When it is empty or its program cannot be found, xdg-open is
used instead.

theme.colorsFile is the JSON file of Material color roles the dock takes its
colors from (matugen's templates/colors.json format). It is watched, so the
dock recolors whenever the file changes.

theme.opacityFile holds a shared background opacity as a percentage (0-100),
written by the Opacity slider in the ML4W sidebar. While the file exists and
holds a number, it overrides opacity.normal; when it is missing or invalid,
opacity.normal is used. Set it to "" to always use opacity.normal.

theme.transparentBorderFile holds "on" or "off", written by the Transparent
Border switch in the ML4W sidebar. On (also when the file is missing or the
setting is ""): the border fades with the background. Off: the border stays at
80% opacity.

theme.blurFile holds "on" or "off", written by the Blur switch in the ML4W
sidebar (which also turns on a Hyprland blur rule). While it is "on", the drop
shadow is hidden, because the blur would end in a hard edge around it.
*/
{
    "dock": {
        "enabled": true,
        "autohide": false,
        "triggerOnDock": false,
        "iconSize": 32,
        "spacing": 8,
        "marginBottom": 16,
        "reserveSpace": true,
        "hideDelay": 400,
        "launcherButton": true,
        "launcherCommand": "~/.config/hypr/scripts/launcher.sh",
        "editorCommand": "~/.config/ml4w/settings/editor.sh"
    },
    "pill": {
        "radius": 16,
        "padding": 12,
        "animationDuration": 350
    },
    "border": {
        "width": 2,
        "colorTop": "",
        "colorBottom": ""
    },
    "opacity": {
        "normal": 0.7
    },
    "theme": {
        "colorsFile": "~/.config/ml4w-dock/colors.json",
        "opacityFile": "~/.config/ml4w/settings/quickshell-opacity",
        "transparentBorderFile": "~/.config/ml4w/settings/quickshell-transparent-border",
        "blurFile": "~/.config/ml4w/settings/quickshell-blur"
    },
    "apps": {
        "pinned": [
            "firefox",
            "kitty"
        ]
    }
}
