#!/usr/bin/env bash
#
# Start the ML4W Dock or send it an IPC call
#

set -euo pipefail

# The dock lives one level above this script. Resolve the symlink in
# ~/.local/bin so the script also works from any other clone.
DOCK_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"

IPC_FUNCTIONS=(
    toggle enable disable
    autohideToggle autohideOn autohideOff
    reload settings edit
)

usage() {
    cat <<USAGE
Usage: ml4w-dock [command]

Commands:
  start             Start the dock (default, does nothing if it is already running)
  stop              Stop the dock
  restart           Stop and start the dock
  toggle            Show or hide the dock
  enable            Show the dock
  disable           Hide the dock
  autohideToggle    Toggle autohide
  autohideOn        Turn autohide on
  autohideOff       Turn autohide off
  reload            Re-read config.json and apply it
  settings          Open the settings dialog
  edit              Open config.json in the configured editor
  help              Show this help
USAGE
}

if ! command -v qs >/dev/null 2>&1; then
    echo ":: ERROR: quickshell (qs) is required but not installed." >&2
    exit 1
fi

command="${1:-start}"

case "$command" in
    start)
        exec qs -n -p "$DOCK_DIR"
        ;;
    stop)
        qs kill -p "$DOCK_DIR"
        ;;
    restart)
        qs kill -p "$DOCK_DIR" >/dev/null 2>&1 || true
        exec qs -n -p "$DOCK_DIR"
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        for fn in "${IPC_FUNCTIONS[@]}"; do
            if [ "$command" = "$fn" ]; then
                exec qs -p "$DOCK_DIR" ipc call dock "$command"
            fi
        done
        echo ":: ERROR: Unknown command: $command" >&2
        usage >&2
        exit 1
        ;;
esac
